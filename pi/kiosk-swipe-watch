#!/usr/bin/python3
"""kiosk-swipe-watch - note when the card reader last typed something.

Reads the reader's key events passively (it does not grab the device, so the
browser still gets every keystroke). Writes the time of the last key to
/run/fsbhoa-kiosk/last-swipe and logs "swipe" once per card. Never logs card
numbers. The watchdog uses the time to decide whether the reader may be hung.
"""
import os, sys, time
import evdev
from evdev import ecodes

STATE_DIR = "/run/fsbhoa-kiosk"
LAST = os.path.join(STATE_DIR, "last-swipe")


def scanner_id():
    sid = "413d:2107"
    try:
        for line in open("/etc/fsbhoa-kiosk/kiosk.conf"):
            line = line.strip()
            if line.startswith("SCANNER_ID="):
                sid = line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    v, p = sid.split(":")
    return int(v, 16), int(p, 16)


def find(vid, pid):
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
        except OSError:
            continue
        if d.info.vendor == vid and d.info.product == pid and ecodes.EV_KEY in d.capabilities():
            caps = d.capabilities().get(ecodes.EV_KEY, [])
            if ecodes.KEY_1 in caps:          # the keyboard interface, not a consumer-control one
                return d
        d.close()
    return None


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    vid, pid = scanner_id()
    missing_logged = False
    while True:
        dev = find(vid, pid)
        if dev is None:
            if not missing_logged:
                print(f"reader {vid:04x}:{pid:04x} not found, waiting", flush=True)
                missing_logged = True
            time.sleep(2)
            continue
        print(f"watching reader at {dev.path} ({dev.name})", flush=True)
        missing_logged = False
        last = 0.0
        try:
            for ev in dev.read_loop():
                if ev.type == ecodes.EV_KEY and ev.value == 1:
                    now = time.time()
                    if now - last > 2:
                        print("swipe", flush=True)
                        tmp = LAST + ".tmp"
                        with open(tmp, "w") as f:
                            f.write(str(int(now)))
                        os.replace(tmp, LAST)
                    last = now
        except OSError:
            print("reader disconnected", flush=True)
            time.sleep(1)


if __name__ == "__main__":
    sys.exit(main())
