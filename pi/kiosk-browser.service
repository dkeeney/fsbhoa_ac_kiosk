[Unit]
Description=FSBHOA lobby kiosk browser (cage + Chromium on tty1)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=pi
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# -d: no window decorations. No -s, so nobody can switch to a text console from the keyboard.
ExecStart=/usr/bin/cage -d -- /usr/local/bin/kiosk-browser
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
